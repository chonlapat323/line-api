generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  label       String
  permissions Json     @default("[]")
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  role         String   @default("user")
  roleId       String?
  bankName           String?
  bankAccount        String?
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roleRef             Role?                 @relation(fields: [roleId], references: [id])
  lineGroups          UserLineGroup[]
  verificationCodes   LineVerificationCode[]
  sentLogs            LineSendLog[]         @relation("SenderLogs")
  receivedLogs        LineSendLog[]         @relation("TargetLogs")
  visitRecords        VisitRecord[]
  commissionsPaid        CommissionPayment[]      @relation("CommissionPaid")
  commissionsPaidBy      CommissionPayment[]      @relation("CommissionPaidBy")
  slipSubmissions        SlipSubmission[]         @relation("SlipSubmissions")
  approvedSlips          SlipSubmission[]         @relation("SlipApprovals")
  commissionAdjustments  CommissionAdjustment[]   @relation("AdjustmentUser")
  adjustmentsCreated     CommissionAdjustment[]   @relation("AdjustmentCreatedBy")
  slipAuditLogs          SlipAuditLog[]           @relation("SlipAuditLogs")
  slipDuplicateLogs      SlipDuplicateLog[]       @relation("DuplicateLogs")
  announcements          Announcement[]           @relation("AnnouncementSender")
}

model UserLineGroup {
  id          String    @id @default(cuid())
  userId      String
  lineGroupId String
  isActive    Boolean   @default(true)
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, lineGroupId])
}

model LineVerificationCode {
  id        String    @id @default(cuid())
  userId    String
  code      String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model LineSendLog {
  id           String   @id @default(cuid())
  senderId     String
  targetUserId String
  lineGroupId  String
  imageUrl     String
  details      Json
  status       String
  errorMessage String?
  createdAt    DateTime @default(now())

  sender     User @relation("SenderLogs", fields: [senderId], references: [id])
  targetUser User @relation("TargetLogs", fields: [targetUserId], references: [id])
}

model CommissionPayment {
  id      String   @id @default(cuid())
  userId  String
  month   String
  amount  Float
  paidBy  String
  note    String?
  slipUrl String?
  paidAt  DateTime @default(now())

  user  User @relation("CommissionPaid",   fields: [userId], references: [id])
  admin User @relation("CommissionPaidBy", fields: [paidBy], references: [id])

  @@unique([userId, month])
}

model SlipSubmission {
  id          String    @id @default(cuid())
  userId      String
  shopName    String
  amount      Float?
  details     String?
  slipUrl     String
  slipStatus    String    // "verified" | "pending_approval" | "approved" | "rejected" | "blocked"
  transRef      String?
  lineStatus    String?   // "sent" | "failed"
  approvedBy    String?
  approvedAt    DateTime?
  debtDeducted  Float     @default(0)
  province    String?
  district    String?
  isProxy     Boolean   @default(false)
  isReceiverBlocked   Boolean   @default(false)
  receiverBankId      String?
  receiverAccountMasked String?
  createdAt   DateTime  @default(now())

  user     User  @relation("SlipSubmissions", fields: [userId], references: [id])
  approver User? @relation("SlipApprovals", fields: [approvedBy], references: [id])
}

model AllowedBankAccount {
  id            String   @id @default(cuid())
  label         String
  bankId        String
  bankName      String
  accountNumber String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CommissionAdjustment {
  id        String   @id @default(cuid())
  userId    String
  month     String
  amount    Float
  type      String   @default("loan_help")
  note      String?
  createdBy String
  createdAt DateTime @default(now())

  user  User @relation("AdjustmentUser",     fields: [userId],    references: [id])
  admin User @relation("AdjustmentCreatedBy", fields: [createdBy], references: [id])
}

model VisitRecord {
  id           String   @id @default(cuid())
  userId       String
  shopName     String
  province     String
  district     String?
  shopNote     String?
  shopPhone    String?
  latitude     Float
  longitude    Float
  tripType     String?
  customerType String
  visitType    String?
  result       String?
  details      String?
  orderAmount  Float?
  imageUrls    String[]
  slipUrl      String?
  slipStatus   String?   // "verified" | "pending_approval" | "approved" | "rejected"
  transRef     String?
  approvedBy   String?
  approvedAt   DateTime?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model SlipDuplicateLog {
  id          String   @id @default(cuid())
  userId      String
  hash        String
  attemptedAt DateTime @default(now())

  user User @relation("DuplicateLogs", fields: [userId], references: [id])
}

model SlipAuditLog {
  id        String   @id @default(cuid())
  slipId    String
  action    String   // submit | admin_create | edit | approve | reject | unblock
  changedBy String
  before    Json?
  after     Json?
  note      String?
  createdAt DateTime @default(now())

  changer User @relation("SlipAuditLogs", fields: [changedBy], references: [id])
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  bodyHtml    String
  imageUrl    String?
  buttonText  String?
  buttonUrl   String?
  status      String   @default("sent") // sent | failed
  errorMessage String?
  sentById    String
  createdAt   DateTime @default(now())

  sentBy User @relation("AnnouncementSender", fields: [sentById], references: [id])
}

model SlipHash {
  id        String   @id @default(cuid())
  hash      String   @unique
  userId    String
  createdAt DateTime @default(now())
}

model SlipVerifyBlock {
  id           String   @id @default(cuid())
  userId       String   @unique
  blockedUntil DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
